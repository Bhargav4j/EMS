@page "{id:int}"
@model EMS.Web.Pages.Employees.DetailsModel
@{
    ViewData["Title"] = "Employee Details";
}

<div class="container">
    <h1>Employee Details</h1>

    @if (Model.Employee == null)
    {
        <div class="alert alert-warning">Employee not found.</div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">@Model.Employee.Id</dd>

                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Employee.Name</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Employee.Email</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.Employee.Phone</dd>

                    <dt class="col-sm-3">Gender</dt>
                    <dd class="col-sm-9">@Model.Employee.Gender</dd>

                    <dt class="col-sm-3">Date of Birth</dt>
                    <dd class="col-sm-9">@Model.Employee.DateOfBirth.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3">Date of Joining</dt>
                    <dd class="col-sm-9">@Model.Employee.DateOfJoining.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3">Department</dt>
                    <dd class="col-sm-9">@Model.Employee.Department?.Name</dd>

                    <dt class="col-sm-3">Job Title</dt>
                    <dd class="col-sm-9">@Model.Employee.JobTitle</dd>

                    <dt class="col-sm-3">Manager</dt>
                    <dd class="col-sm-9">@(Model.Employee.Manager?.Name ?? "No Manager")</dd>

                    <dt class="col-sm-3">Salary</dt>
                    <dd class="col-sm-9">@Model.Employee.Salary.ToString("C")</dd>

                    <dt class="col-sm-3">Commission</dt>
                    <dd class="col-sm-9">@Model.Employee.Commission.ToString("C")</dd>
                </dl>

                <div class="mt-3">
                    <a asp-page="Edit" asp-route-id="@Model.Employee.Id" class="btn btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@Model.Employee.Id" class="btn btn-danger">Delete</a>
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    }
</div>
