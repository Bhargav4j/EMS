@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@model EMS.Web.Pages.Employees.CreateModel
@{
    ViewData["Title"] = "Create Employee";
}

<h1>Create Employee</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Input.Name" class="control-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Email" class="control-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.DepartmentNo" class="control-label"></label>
                <select asp-for="Input.DepartmentNo" class="form-select" asp-items="Model.Departments"></select>
                <span asp-validation-for="Input.DepartmentNo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.JobTitle" class="control-label"></label>
                <input asp-for="Input.JobTitle" class="form-control" />
                <span asp-validation-for="Input.JobTitle" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Salary" class="control-label"></label>
                <input asp-for="Input.Salary" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Input.Salary" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Commission" class="control-label"></label>
                <input asp-for="Input.Commission" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Input.Commission" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.DateOfBirth" class="control-label"></label>
                <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.DateOfJoining" class="control-label"></label>
                <input asp-for="Input.DateOfJoining" class="form-control" type="date" />
                <span asp-validation-for="Input.DateOfJoining" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.ReportingTo" class="control-label"></label>
                <select asp-for="Input.ReportingTo" class="form-select" asp-items="Model.Managers">
                    <option value="">-- Select Manager --</option>
                </select>
                <span asp-validation-for="Input.ReportingTo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Phone" class="control-label"></label>
                <input asp-for="Input.Phone" class="form-control" />
                <span asp-validation-for="Input.Phone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Gender" class="control-label"></label>
                <select asp-for="Input.Gender" class="form-select">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Input.Gender" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
