@page
@model EMS.Web.Pages.Employees.CreateModel
@{
    ViewData["Title"] = "Create Employee";
}

<div class="container">
    <h1>Create Employee</h1>

    <form method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Phone" class="form-label"></label>
                    <input asp-for="Input.Phone" class="form-control" />
                    <span asp-validation-for="Input.Phone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Gender" class="form-label"></label>
                    <select asp-for="Input.Gender" class="form-select">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Input.Gender" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.DateOfBirth" class="form-label"></label>
                    <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.DateOfJoining" class="form-label"></label>
                    <input asp-for="Input.DateOfJoining" class="form-control" type="date" />
                    <span asp-validation-for="Input.DateOfJoining" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.DepartmentId" class="form-label"></label>
                    <select asp-for="Input.DepartmentId" class="form-select" asp-items="Model.Departments">
                        <option value="">Select Department</option>
                    </select>
                    <span asp-validation-for="Input.DepartmentId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.JobTitle" class="form-label"></label>
                    <input asp-for="Input.JobTitle" class="form-control" />
                    <span asp-validation-for="Input.JobTitle" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ReportingTo" class="form-label"></label>
                    <select asp-for="Input.ReportingTo" class="form-select" asp-items="Model.Managers">
                        <option value="">No Manager</option>
                    </select>
                    <span asp-validation-for="Input.ReportingTo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Salary" class="form-label"></label>
                    <input asp-for="Input.Salary" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.Salary" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Commission" class="form-label"></label>
                    <input asp-for="Input.Commission" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.Commission" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
