@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@model EMS.Web.Pages.Employees.DeleteModel
@{
    ViewData["Title"] = "Delete Employee";
}

<h1>Delete Employee</h1>

<h3>Are you sure you want to delete this employee?</h3>
<div>
    <hr />
    @if (Model.Employee != null)
    {
        <dl class="row">
            <dt class="col-sm-3">Number</dt>
            <dd class="col-sm-9">@Model.Employee.Number</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Employee.Name</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Employee.Email</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@(Model.Employee.Department?.Name ?? "N/A")</dd>

            <dt class="col-sm-3">Job Title</dt>
            <dd class="col-sm-9">@Model.Employee.JobTitle</dd>

            <dt class="col-sm-3">Salary</dt>
            <dd class="col-sm-9">@Model.Employee.Salary.ToString("C")</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Employee.Number" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-page="Index" class="btn btn-secondary">Back to List</a>
        </form>
    }
    else
    {
        <p>Employee not found.</p>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    }
</div>
