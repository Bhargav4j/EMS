@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@model EMS.Web.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

@if (Model.Employees != null && Model.Employees.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Number</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Job Title</th>
                    <th>Salary</th>
                    <th>Manager</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model.Employees)
                {
                    <tr>
                        <td>@employee.Number</td>
                        <td>@employee.Name</td>
                        <td>@employee.Email</td>
                        <td>@(employee.Department?.Name ?? "N/A")</td>
                        <td>@employee.JobTitle</td>
                        <td>@employee.Salary.ToString("C")</td>
                        <td>@(employee.Manager?.Name ?? "No Manager")</td>
                        <td>
                            <a asp-page="Details" asp-route-id="@employee.Number" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="Edit" asp-route-id="@employee.Number" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="Delete" asp-route-id="@employee.Number" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>No employees found.</p>
}
