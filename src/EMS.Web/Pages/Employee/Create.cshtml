@page
@model EMS.Web.Pages.Employee.CreateModel
@{
    ViewData["Title"] = "Create Employee";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Employee.Name" class="form-label"></label>
                <input asp-for="Employee.Name" class="form-control" />
                <span asp-validation-for="Employee.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.Email" class="form-label"></label>
                <input asp-for="Employee.Email" class="form-control" />
                <span asp-validation-for="Employee.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.DepartmentNo" class="form-label"></label>
                <select asp-for="Employee.DepartmentNo" asp-items="Model.DepartmentList" class="form-select">
                    <option value="">-- Select Department --</option>
                </select>
                <span asp-validation-for="Employee.DepartmentNo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.Gender" class="form-label"></label>
                <select asp-for="Employee.Gender" class="form-select">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Employee.Gender" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.DateOfBirth" class="form-label"></label>
                <input asp-for="Employee.DateOfBirth" class="form-control" />
                <span asp-validation-for="Employee.DateOfBirth" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.DateOfJoining" class="form-label"></label>
                <input asp-for="Employee.DateOfJoining" class="form-control" />
                <span asp-validation-for="Employee.DateOfJoining" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.ReportingTo" class="form-label"></label>
                <select asp-for="Employee.ReportingTo" asp-items="Model.ManagerList" class="form-select">
                    <option value="">-- No Manager --</option>
                </select>
                <span asp-validation-for="Employee.ReportingTo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.Phone" class="form-label"></label>
                <input asp-for="Employee.Phone" class="form-control" />
                <span asp-validation-for="Employee.Phone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.Salary" class="form-label"></label>
                <input asp-for="Employee.Salary" class="form-control" />
                <span asp-validation-for="Employee.Salary" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.Commission" class="form-label"></label>
                <input asp-for="Employee.Commission" class="form-control" />
                <span asp-validation-for="Employee.Commission" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Employee.JobTitle" class="form-label"></label>
                <input asp-for="Employee.JobTitle" class="form-control" />
                <span asp-validation-for="Employee.JobTitle" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
