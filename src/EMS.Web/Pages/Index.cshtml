@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Employee Management System</h1>
    <p class="lead">Manage your employees and departments efficiently.</p>

    <div class="row mt-5">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Employees</h5>
                    <p class="card-text">View, add, edit, and manage employee records.</p>
                    <a asp-page="/Employees/Index" class="btn btn-primary">Go to Employees</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Departments</h5>
                    <p class="card-text">Manage departments and organizational structure.</p>
                    <a asp-page="/Departments/Index" class="btn btn-primary">Go to Departments</a>
                </div>
            </div>
        </div>
    </div>
</div>
